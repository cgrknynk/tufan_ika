<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="teb_robot">

  <!-- ================== GEOMETRİ VE KİNEMATİK ================== -->
  
  <link name="base_footprint"/>

  <joint name="base_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <!-- yaw=pi: govde (base_link) gercek arac onune gore 180 derece donuktu.
         lidar/imu/caster'in base_link'e gore konumlari degismedi; hepsi
         birlikte, tek bir katı govde gibi, dogru yone donuyor. -->
    <origin xyz="0 0 0.275" rpy="0 0 3.14159265358979"/>
  </joint>

  <!-- Şasi (Boy: 1.65m, Genişlik: 1.1m, Yükseklik: 0.55m) -->
  <link name="base_link">
    <visual>
      <geometry><box size="1.65 1.1 0.55"/></geometry>
      <material name="blue"><color rgba="0 0 0.8 1"/></material>
    </visual>
    <collision>
      <geometry><box size="1.65 1.1 0.55"/></geometry>
    </collision>
    <inertial>
      <mass value="35.0"/>
      <inertia ixx="4.5" ixy="0" ixz="0" iyy="8.0" iyz="0" izz="11.0"/>
    </inertial>
  </link>

  <!-- Sağ Tekerlek -->
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="right_wheel"/>
    <origin xyz="-0.2 -0.575 -0.2" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="right_wheel">
    <visual><geometry><cylinder radius="0.2" length="0.05"/></geometry></visual>
    <collision><geometry><cylinder radius="0.2" length="0.05"/></geometry></collision>
    <inertial><mass value="1.5"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/></inertial>
  </link>

  <!-- Sol Tekerlek -->
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="left_wheel"/>
    <origin xyz="-0.2 0.575 -0.2" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>
  <link name="left_wheel">
    <visual><geometry><cylinder radius="0.2" length="0.05"/></geometry></visual>
    <collision><geometry><cylinder radius="0.2" length="0.05"/></geometry></collision>
    <inertial><mass value="1.5"/><inertia ixx="0.004" ixy="0" ixz="0" iyy="0.004" iyz="0" izz="0.007"/></inertial>
  </link>

  <!-- Sarhoş Tekerlek (Caster) - Ön Kısma Taşındı -->
  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_wheel"/>
    <origin xyz="-0.6 0 -0.30" rpy="0 0 0"/>
  </joint>
  <link name="caster_wheel">
    <visual><geometry><sphere radius="0.1"/></geometry></visual>
    <collision><geometry><sphere radius="0.1"/></geometry></collision>
    <inertial><mass value="0.8"/><inertia ixx="0.0008" ixy="0" ixz="0" iyy="0.0008" iyz="0" izz="0.0008"/></inertial>
  </link>

  <!-- ================== SENSÖRLER (LIDAR & IMU) ================== -->
  
  <!-- LIDAR Link - Şasi Üzerine Konumlandırıldı -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- NOT: base_link (govde) artik base_footprint'e gore pi donuk oldugu icin
         buradaki rpy=0 ile toplam (net) donus base_footprint'e gore pi olur.
         Onceki pi degeri, govde donusuyle birlikte 2*pi=0'a (yanlis) donuyordu. -->
    <origin xyz="-0.5 0 0.30" rpy="0 0 0"/>
  </joint>
  <link name="lidar_link">
    <visual><geometry><cylinder radius="0.05" length="0.05"/></geometry></visual>
  </link>

  <!-- IMU Link - Şasi Merkezine Konumlandırıldı -->
  <joint name="imu_joint" type="fixed">
    <parent link="base_link"/>
    <child link="imu_link"/>
    <!-- yaw=pi: IMU'nun fiziksel "ileri" ekseni, lidar/caster ile ayni yonde
         duzeltilen gercek arac onu ile eslesmesi icin 180 derece dondurulduu -->
    <origin xyz="0 0 0.2" rpy="0 0 3.14159265358979"/>
  </joint>
  <link name="imu_link"/>

  <!-- ================== GAZEBO PLUGINS (ROS 2) ================== -->

  <!-- Diferansiyel Sürüş ve Odometri -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>1.15</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>200</max_wheel_torque>
      <max_wheel_acceleration>2.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 2D LIDAR Sensörü -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>true</visualize>
      <update_rate>10</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>360</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.15</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </ray>
      <plugin name="gazebo_ros_lidar" filename="libgazebo_ros_ray_sensor.so">
        <ros><remapping>~/out:=scan</remapping></ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- IMU Sensörü -->
  <gazebo reference="imu_link">
    <sensor type="imu" name="imu_sensor">
      <always_on>true</always_on>
      <update_rate>50</update_rate>
      <plugin name="gazebo_ros_imu" filename="libgazebo_ros_imu_sensor.so">
        <ros><remapping>~/out:=imu/data</remapping></ros>
        <initial_orientation_as_reference>false</initial_orientation_as_reference>
        <frame_name>imu_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- Sürtünme Ayarları -->
  <gazebo reference="caster_wheel">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>
</robot>
