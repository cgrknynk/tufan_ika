             <property name="styleSheet">
              <string notr="true">QTextEdit {
    background-color: #05050A;     /* Simsiyah, derin terminal arka planı */
    color: #00FF00;                /* Neon / Hacker Yeşili yazı rengi */
    border: 2px solid #333344;     /* Koyu gri ince çerçeve */
    border-radius: 48px;           /* Fotoğraftaki gibi yuvarlak hatlar */
    padding: 10px;                 /* Yazılar kenara yapışmasın diye iç boşluk */
    font-size: 14px;
    font-weight: bold;
    font-family: &quot;Roboto Mono&quot;, &quot;Consolas&quot;; /* Tam bir yazılımcı fontu */
}

/* Sağdaki kaydırma çubuğunu (Scrollbar) da arayüze uyduralım (Opsiyonel ama çok şık olur) */
QTextEdit QScrollBar:vertical {
    background: #111;
    width: 10px;
}
QTextEdit QScrollBar::handle:vertical {
    background: #444;
    border-radius: 5px;
}</string>
