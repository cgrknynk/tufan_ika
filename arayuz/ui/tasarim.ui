             <property name="styleSheet">
              <string notr="true">QPushButton {
    background-color: #22222A;
    color: #888888;
    border: 2px solid #444455;
    
    /* İŞTE KUSURSUZ HAP (PILL) MATEMATİĞİ (40'ın yarısı) */
    border-radius: 20px; 
    
    /* DİKKAT: Üst ve alt boşluğu SIFIR (0px) yaptık ki şişmesin! Sadece yanlardan boşluk verdik. */
    padding: 0px 20px; 
    
    font-size: 16px;
    font-weight: bold;
    font-family: &quot;Roboto Mono&quot;;
    outline: none;
}

QPushButton:hover {
    border: 2px solid #00AAFF;
}

QPushButton:checked {
    background-color: #00AAFF;
    color: #FFFFFF;
    border: 2px solid #00FFFF;
}

QPushButton:checked:hover {
    background-color: #00BBFF;
}</string>
