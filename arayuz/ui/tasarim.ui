             <property name="styleSheet">
              <string notr="true">/* --- Normal Durum --- */
QPushButton#pushButton_KAYIT {
    background-color: #252530;  /* Koyu Gri Zemin */
    color: white;               /* Beyaz Yazı */
    border: 2px solid #555;     /* Biraz daha kalın çerçeve */
    border-radius: 24px;        /* Daha yuvarlak köşeler */
    
    font-weight: bold;          /* Kalın Yazı */
    font-size: 24px;            /* &lt;--- İŞTE YAZIYI BÜYÜTEN KISIM (16 veya 18 dene) */
    font-family: &quot;Roboto Mono&quot;; /* Veya senin ana fontun */
    
    padding: 10px;              /* İçeriden boşluk ver ki sıkışmasın */
    text-align: left;           /* İkon solda, yazı sağda düzgün dursun */
    padding-left: 30px;         /* İkon ile sol kenar arası mesafe */
}

/* --- Fare Üzerine Gelince (Hover) --- */
QPushButton#pushButton_KAYIT:hover {
    background-color: #30303A;  /* Zemin hafif aydınlansın */
    border-color: #FF0000;      /* Çerçeve kırmızılaşsın (Kayıt sinyali gibi) */
}

/* --- Basılma Efekti (Pressed) --- */
QPushButton#pushButton_KAYIT:pressed {
    background-color: #101015;  /* Basınca zemin iyice koyulaşsın (İçe göçme hissi) */
    border-color: #990000;      /* Çerçeve koyu kırmızı olsun */
    padding-top: 12px;          /* Yazıyı 2px aşağı it (Mekanik buton hissi verir) */
    padding-left: 17px;
}</string>
             </property>
             <property name="text">
              <string>Veri Kaydet</string>
             </property>
             <property name="icon">
              <iconset>
               <normaloff>:/ikonlar/resimler/record-2 5.svg</normaloff>:/ikonlar/resimler/record-2 5.svg</iconset>
             </property>
             <property name="iconSize">
              <size>
               <width>48</width>
               <height>48</height>
              </size>
             </property>
            </widget>
           </widget>
