             <property name="styleSheet">
              <string notr="true">/* --- 1. ANA COMBOBOX (KAPALI HALİ) --- */
QComboBox {
    background-color: #151520;
    color: #FFFFFF;
    border: 2px solid #444455;
    border-radius: 12px;
    padding: 8px 15px;
    font-size: 22px;
    font-family: &quot;Roboto Mono&quot;;
}

QComboBox:hover {
    border: 2px solid #00AAFF;
}

QComboBox::drop-down {
    border: none;
    width: 40px;
}

/* --- 2. AÇILAN LİSTENİN DIŞ KUTUSU --- */
QComboBox QAbstractItemView {
    background-color: #151520;
    border: 2px solid #00AAFF;
    border-radius: 12px;
    padding: 6px;         /* İŞTE ÇÖZÜM: Listenin iç duvarlarına 6px yastık koyduk */
    outline: none;
}

/* --- 3. LİSTE ELEMANLARI (Türkçe, English) --- */
QComboBox QAbstractItemView::item {
    color: #FFFFFF;
    min-height: 40px;
    border-radius: 6px;   /* Şıkların da köşelerini yuvarladık */
}

/* --- 4. SEÇİLİ OLAN ŞIK (Mavi Yanan Kısım) --- */
QComboBox QAbstractItemView::item:selected {
    background-color: #00AAFF;
    color: #FFFFFF;
    border-radius: 6px;   /* MAVİ SEÇİMİN KÖŞELERİ KESİNLİKLE YUVARLAK OLACAK */
}

QComboBox QAbstractItemView::item:hover {
    background-color: #00AAFF;
    color: #FFFFFF;
    border-radius: 6px;
}</string>
             </property>
