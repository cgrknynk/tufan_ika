    background-color: #151520;  /* Koyu arka plan */
    color: #FFFFFF;             /* Yazı rengi beyaz */
    border: 1px solid #444455;  /* Sönük gri çerçeve */
    border-radius: 12px;         /* Köşeler hafif yuvarlak */
    padding: 5px 10px;          /* İçeriden boşluk (ferah dursun) */
    font-size: 26px;
    font-family: &quot;Roboto Mono&quot;;
}

/* Mouse ile içine tıklanıp YAZI YAZILMAYA BAŞLANDIĞINDA (Focus) */
QLineEdit:focus {
    border: 1px solid #00AAFF;  /* Çerçeve Mavi Parlasın */
    background-color: #1A1A25;
}</string>
